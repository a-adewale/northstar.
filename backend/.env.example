PORT=3100
WEB_ORIGIN=http://localhost:5187
# Set MONGODB_URI to use a persistent replica set; npm run dev otherwise uses a temporary local MongoDB.
# MONGODB_URI=mongodb://127.0.0.1:27019/banking?replicaSet=rs0&directConnection=true
# Required for npm start; dev generates a temporary secret when absent.
JWT_SECRET=replace-with-at-least-32-random-characters
# Production uses secure cookies and requires HTTPS.
NODE_ENV=development
PAYSTACK_SECRET_KEY=sk_test_your_test_key_here
